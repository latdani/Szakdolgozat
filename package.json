{
  "name": "szakdolgozat",
  "version": "1.0.0",
  "description": "Edzés- és Étkezésnapló Webalkalmazás",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm start --prefix frontend",
    "backend": "npm start --prefix backend",
    "install-all": "npm install && npm install --prefix frontend && npm install --prefix backend"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}